# Одна строка как выдал заказчик (user:pass_flags@host:port)
PROXY=

# Несколько строк — по одной на sticky-сессию
PROXY_FILE=config/proxies.txt

# SOCKS5 у IPRoyal — тот же логин, другой порт
SOCKS_PORT=32325
EXPECT_COUNTRY=us

CHECK_URL=https://ipv4.icanhazip.com
HTTP_CHECK_URL=http://icanhazip.com
GEO_URL=https://ipinfo.io/json

CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
CHROME_VERSION=152
# Только сборка образа: пакет google-chrome-stable_…_amd64.deb
CHROME_DEB_VERSION=152.0.7977.82-1
HEADLESS=0
VNC=1
PROFILE_DIR=profile
SCREENSHOTS_DIR=screenshots
LOGS_DIR=logs
BROWSER_LANG=en-US
WINDOW_SIZE=1920,1080
PAGE_URL=https://shop.axs.com/?c=axs&e=6414022407626854
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8080
